# Copy to a private .env file and set real values outside Git.
CALL_RECORDER_LISTEN_ADDRESS=0.0.0.0
CALL_RECORDER_LISTEN_PORT=8080
CALL_RECORDER_DATABASE_URL=postgresql://call_recorder:CHANGE_ME@postgres:5432/call_recorder
CALL_RECORDER_PUBLIC_URL=https://logger.renfrewcountyscanner.com
CALL_RECORDER_AUDIO_ROOT=/var/lib/call-recorder/audio
CALL_RECORDER_EXPORT_ROOT=/var/lib/call-recorder/exports
CALL_RECORDER_RETENTION_DAYS=60
CALL_RECORDER_DUPLICATE_START_TOLERANCE_MS=2000
CALL_RECORDER_DUPLICATE_DURATION_TOLERANCE_MS=300
POSTGRES_DB=call_recorder
POSTGRES_USER=call_recorder
POSTGRES_PASSWORD=CHANGE_ME
CALL_RECORDER_PORT=8080
CALL_RECORDER_BOOTSTRAP_SENDER_ID=example-sender
CALL_RECORDER_BOOTSTRAP_SENDER_KEY=CHANGE_ME
# Browser pages require authentication. Keep the origin behind Cloudflare Access or a private network.
CALL_RECORDER_AUTH_REQUIRED=true
CALL_RECORDER_LOCAL_AUTH_ENABLED=true
CALL_RECORDER_SESSION_COOKIE_SECURE=true
CALL_RECORDER_SESSION_MAX_AGE_SECONDS=2592000
CALL_RECORDER_AUTH_LOGIN_URL=
CALL_RECORDER_ADMIN_ENABLED=true
CALL_RECORDER_ADMIN_OPEN=false
CALL_RECORDER_ADMIN_TOKEN=CHANGE_ME
CALL_RECORDER_SESSION_SECRET=CHANGE_ME
# For production, prefer Cloudflare Access over the local admin token.
CALL_RECORDER_CLOUDFLARE_ACCESS_ENABLED=false
CALL_RECORDER_CLOUDFLARE_ADMIN_EMAIL=renfrewcountyscanner@gmail.com
CALL_RECORDER_CLOUDFLARE_TRUSTED_PROXY_IPS=192.168.120.2,192.168.220.2
