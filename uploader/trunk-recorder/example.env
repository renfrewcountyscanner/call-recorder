DESTINATION_URL=https://call-recorder.example.invalid
UPLOAD_ID=recorder-a
UPLOAD_KEY=replace-with-a-private-key
SYSTEM_NAME=example-system
SPOOL_DIR=/var/lib/call-recorder-uploader
RETRY_COUNT=5
TIMEOUT_SECONDS=30
# Manual legacy-directory import settings. Successful files are archived by
# default with their relative directory layout preserved.
IMPORT_ROOT=/logger-import
IMPORT_SUCCESS_ACTION=archive
IMPORT_ARCHIVE_ROOT=/logger-import-archive
IMPORT_MIN_AGE_SECONDS=120
IMPORT_MAX_AUDIO_BYTES=104857600
# Optional independent second destination.
# SECONDARY_DESTINATION_URL=https://second.example.invalid
# SECONDARY_UPLOAD_ID=recorder-a-secondary
# SECONDARY_UPLOAD_KEY=replace-with-a-second-private-key
